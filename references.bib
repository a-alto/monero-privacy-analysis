@misc{monero_security_analysis_mrl,
title = {{History and state of Monero security analysis}},
year = {2024},
URL = {https://github.com/cypherstack/pup-monero-analysis/releases/download/final/final.pdf},
booktitle = {Cypher Stack},
author = {Goodell, Brandon},
abstract = {Monero is a distributed digital asset whose protocol and implementations are intended to use cryptographic and other techniques to improve privacy and safety. Years of analysis on Monero and other digital asset protocols and implementations have uncovered a variety of techniques that an adversary might use to degrade these properties. This technical note provides an overview of the history of such analysis. Many, but not all, of those methods have since been at least partially mitigated through protocol or implementation changes. While some methods were theoretical or otherwise not particularly effective, other concerning attack and analysis surfaces remain. As the Monero community is discussing new protocol research that fundamentally improves the nature of its privacy goals, focus is particularly given to the impacts of such changes on previous analysis.},
howpublished = {Monero Research Lab},
file = {history-and-state-of-Monero-security-analysis.pdf:https://moneroresearch.info/index.php?action=attachments{\_}ATTACHMENTS{\_}CORE{\&}method=downloadAttachment{\&}id=227{\&}resourceId=235{\&}filename=0793f63665e4c806c006135477d4193f20dd7ad0}
